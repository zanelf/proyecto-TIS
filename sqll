CREATE TABLE Solicitud (
    solicitud_ID INT PRIMARY KEY AUTO_INCREMENT,
    Tipo_estado ENUM('Felicitaciones', 'Reclamo', 'Sugerencia'),
    Asunto VARCHAR(100),
    Descripcion VARCHAR(100),
    RUT_ciudadano INT, -- Mismo tipo de dato que la PK padre
    FOREIGN KEY (RUT_ciudadano) REFERENCES ciudadano(RUT_ciudadano)
    ID_departamento INT, -- Mismo tipo de dato que la PK padre
    FOREIGN KEY (ID_departamento) REFERENCES departamento(ID_departamento)
    ID_tipo_solicitud INT, -- Mismo tipo de dato que la PK padre
    FOREIGN KEY (ID_tipo_solicitud) REFERENCES tipo_solicitud(ID_tipo_solicitud)
) ENGINE=InnoDB;

CREATE TABLE Encuesta (
    ID_encuesta INT PRIMARY KEY AUTO_INCREMENT,
    Pregunta VARCHAR(100),
    RUT_ciudadano INT, -- Mismo tipo de dato que la PK padre
    FOREIGN KEY (RUT_ciudadano) REFERENCES ciudadano(RUT_ciudadano)
    solicitud_ID INT, -- Mismo tipo de dato que la PK padre
    FOREIGN KEY (solicitud_ID) REFERENCES Solicitud(solicitud_ID)
) ENGINE=InnoDB;

CREATE TABLE Comprobante (
    ID_comprobante INT PRIMARY KEY AUTO_INCREMENT,
    Fecha date,
    Hora Time, -- Mismo tipo de dato que la PK padre
    solicitud_ID INT, -- Mismo tipo de dato que la PK padre
    FOREIGN KEY (solicitud_ID) REFERENCES Solicitud(solicitud_ID)
) ENGINE=InnoDB;

